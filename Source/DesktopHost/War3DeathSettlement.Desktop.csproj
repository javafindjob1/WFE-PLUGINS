<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>War3DeathSettlement</AssemblyName>
    <RootNamespace>War3DeathSettlement.Desktop</RootNamespace>
    <Version>2.2.20</Version>
    <AssemblyVersion>2.2.20.0</AssemblyVersion>
    <FileVersion>2.2.20.0</FileVersion>
    <Product>War3DeathSettlement</Product>
    <AssemblyTitle>魔兽死亡结算 Vue Desktop</AssemblyTitle>
    <Company>wfe-library-demagewatcher</Company>
    <Copyright>Copyleft</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <DebugType>none</DebugType>
    <ErrorReport>none</ErrorReport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\Core\SelfTest.cs" />
    <Compile Include="..\WebHost\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\WebHost\SnapshotReader.cs" Link="Shared\SnapshotReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
