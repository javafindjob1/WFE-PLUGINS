<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>War3DeathSettlement</AssemblyName>
    <RootNamespace>War3DeathSettlement</RootNamespace>
    <Version>1.3.6</Version>
    <AssemblyVersion>1.3.6.0</AssemblyVersion>
    <FileVersion>1.3.6.0</FileVersion>
    <Product>War3DeathSettlement</Product>
    <AssemblyTitle>魔兽死亡结算 (War3 Death Settlement)</AssemblyTitle>
    <Company>wfe-library-demagewatcher</Company>
    <Copyright>Copyleft</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <DebugType>none</DebugType>
    <ErrorReport>none</ErrorReport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 提权清单：requireAdministrator（启动即管理员，资源管理器显示 UAC 盾牌） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFO0003：WinForms 建议把高 DPI 配置交给 Application.SetHighDpiMode。
      这里故意保留在清单里：清单在托管代码运行前生效，PerMonitorV2 才不会在
      第一帧就按 96 DPI 布局（Program.Main 里那句 SetProcessDPIAware 只是兜底）。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebHost / DesktopHost 是独立项目，不能进入主程序默认编译项。 -->
    <Compile Remove="WebHost\**\*.cs" />
    <Compile Remove="DesktopHost\**\*.cs" />
    <EmbeddedResource Remove="WebHost\**\*" />
    <EmbeddedResource Remove="DesktopHost\**\*" />
    <None Remove="WebHost\**\*" />
    <None Remove="DesktopHost\**\*" />
  </ItemGroup>

</Project>
