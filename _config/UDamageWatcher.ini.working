; ============================================================================
; UDamageWatcher 伤害监视插件 配置文件（ANSI/GBK 编码，改完需重启游戏生效）
; 删掉本文件会按下面的默认值重新生成一份带注释的。
; ============================================================================

; ---- 游戏内聊天命令（只认本地玩家自己发的）----
;   @0 = 只显示【伤害来源】为自己的
;   @1 = 只显示【伤害来源】为自己或友方的
;   @2 = 只显示【伤害来源】为敌人的
;   @3 = 关闭显示（连日志一起停；之后发 @0/@1/@2 可随时恢复）
;   @<单位> = 开始记录【这个单位受到的伤害】，死亡时自动结算
;             <单位> 可以是单位名字（如 @魔狼人）、单位类型码（如 @uske）、
;             或 #十六进制句柄（如 @#00102D3E）。同名单位各自独立记账。
;   @?  = 立刻打印当前所有在记录单位的统计（不死亡也能看）
;   @!  = 停止记录并结算
;   统计口径：四个维度【联合】成一个键，不按维度分别统计；
;             每行给出该组合的 次数 / 伤害 / 伤害占比
;             键顺序 = 是否攻击/是否远程/攻击类型/伤害类型（都是原始数字）
;             末尾另给一段【按来源单位类型】的伤害占比（同类单位的多个实例合并成一行）
;   track_min_damage = 按单位统计时只统计【大于】这个值的伤害（默认 5；0=全部统计）
;                      只影响记账；显示与死亡结算不受影响
; 前缀由 chat_prefix 配置；每次切换消息区会回一条回执。

; ---- 总开关 ----
; enable    : 1=启用插件  0=完全停用（不钩、不显示、不记日志）
; start_hint: 1=进游戏第一次挨打时提示一行【怎么开启】 0=完全不打扰（默认）
; log_only  : 1=只写日志不显示  0=日志+屏幕都出。第一次实测建议先用 1 验证数据
enable=1
log_only=0

; ---- 显示模式 ----
; mode      : 启动时的模式  0=只显示来源为自己  1=只显示来源为自己/友方  2=只显示来源为敌人  3=关闭
;             （进游戏后用 @0/@1/@2/@3 随时切换，会覆盖这里的初值）
; chat_cmd  : 1=允许游戏内聊天命令切换  0=只能用本文件的 mode
; chat_prefix: 命令前缀，默认 @
; block_cmd : 1=拦截 @ 命令，只本地处理、不广播给其他玩家（默认）；0=照旧广播（盟友看得到）
; filter_side: 模式 0/1/2 按哪一方判定  0=来源方(看“伤害来源”是谁，默认)
;                                    1=目标方(看“挨打的是谁”)
;                                    2=任一方(来源或目标任一方满足即显示)
start_hint=0
mode=3
chat_cmd=1
chat_prefix=@
block_cmd=1

; ---- 直投聊天框发消息（v1.4.1，测试热键 Ctrl+Alt+E）----
; 做法照 WFE 的 build_tools\hello_direct.c：不用 SendInput、不要求游戏在前台；
;   流程 = 设收件人 -> SendMessageA(WM_CHAR) 把字投进聊天框 -> 调游戏窗口过程发回车。
; chat_send_target: 收件人  0=全部  1=盟友（只发给队友，默认）  2=观察者
chat_send_target=1
; chat_on_death: 1=死亡总结【无框直投】到聊天（默认）  0=不发送（只写日志）
chat_on_death=1
filter_side=0

; ---- 过滤 ----
; skip_locust: 1=来源或目标带 'Aloc'(蝗虫技能) 的事件跳过（滤伤害检测马甲用）
;              默认 0=不过滤 —— 很多自定义图会给普通单位加 'Aloc'，开了会误伤正常伤害
; filter_zero: 1=伤害 <= 0 的事件不显示
; min_amount : 伤害低于此值不显示（0=不过滤）
; only_related: 1=只有自己或自己盟友的单位参与才显示  0=所有人的伤害都显示
; throttle_ms: 显示节流（毫秒）。0=不节流；AOE 刷屏时设 100~200 会舒服很多
skip_locust=0
filter_zero=1
min_amount=0
only_related=0
throttle_ms=0

; ---- 显示内容 ----
; show_hp    : 1=显示 生命:当前/最大
; show_weapon: 1=显示 武器:<数字>
; show_owner : 1=显示受伤单位的拥有者玩家名
; color      : 1=整行带颜色（黄色）
; labels     : 1=中文标签（默认）  0=强制 ASCII 标签。v1.3.18 起编码判不出来也用中文（按 UTF-8）
; encoding   : 游戏文本编码  0=自动判定（判不出来按 UTF-8）  1=强制 GBK(936)  2=强制 UTF-8(65001)
;              ? 屏幕上中文变成乱码时：先试 encoding=1（GBK），再试 =2（UTF-8）。
;              （本机实测该魔兽内部是 UTF-8；换成别的版本若中文乱码可手动指定）
; 伤害明细（飘在受伤单位头上的那行）v1.3.1 起【只显示数字】：
;     是否攻击/是否远程/攻击类型/伤害类型 伤害值     例: 1/0/5/4 154.7
;   （来源名/目标名不再写进飘字；名字/武器/生命在日志里一直有）
show_hp=0
show_weapon=0
show_owner=0
color=1
labels=1
encoding=2

; ---- 显示通道：TextTag 飘字（B 计划）----
; 屏幕输出（伤害明细 / 回执 / 统计结算）全部走引擎的 TextTag —— 飘在单位头上的字，
; 不再往消息区发 DisplayTimedTextToPlayer。
; 飘字必须绑一个单位：锚点优先用【受伤单位 / 被记账的单位】，其次最近一次伤害事件、
; 当前选中单位、正在记账的单位；四个都取不到时只写日志（不显示，绝不猜坐标乱飘）。
;               伤害明细那种长行折成 2~3 段正好压在单位头上；设 0 会横穿整个屏幕。

; ---- 日志 ----
; log_events : 0=【跟随明细开关】玩家开启明细（@0/@1/@2）后日志同步逐条输出；静默（@3）时不写（默认）
;              1=即使静默也逐条记录（纯排错用，日志会随伤害事件数增长）
; debug      : 调试日志开关（v1.3.3）。0=关（默认）：只留配置/启动结果/每笔明细 H 行/统计与结算/热键/异常；1=打开排错信息。
debug=0
;               上屏规则（v1.3.14）：结算只有【Ctrl+Alt+R 选中的单位】才上屏；聊天命令记的单位只写日志。
; ydbase_wait: 等 ydbase 注入的最长秒数。【本项目当前设 0 = 只探一次，没有就立刻转 native】
ydbase_wait=0
; native_chain: 引擎伤害函数入口被别人挂钩时（WFE 伤害数字/平台 JAPI）是否改用链式挂钩。1=开（默认）；0=老行为（直接安全退出）
native_chain=1
log_events=0
; log_max_lines: 日志最多写多少行。0 = 不设上限（默认，日志保留完整的）；填正整数则到上限后停止记录。
; 每笔伤害在开启明细/排错时会写三行完整记录：D(引擎原始字段) / DN(native 结构头 8 dword) / H(人看得懂的完整明细)
log_max_lines=0
; track_min_damage: 结算统计门槛（默认 5）——【小于该值的伤害不统计】（0=全记；0/负伤害永远不计）。
;                  只影响记账（次数/总计/组合/来源）；屏幕逐条明细的门槛是 min_amount；不影响死亡判定。
track_min_damage=5
; hotkeys: 1=启用热键（Ctrl+Alt+数字/R/Q/S）。热键不走聊天，命令不会发给别人。
hotkeys=1

; pick: auto(default)|memory|on|off|reuse -- Ctrl+Alt+R/T selection pick.
;   auto = memory-read first (safe in multiplayer); falls back to group-enum in single player.
pick=auto
; ---- 后端（从哪儿取"伤害事件"）----
; native = 【引擎直连】（**当前默认**）：不用 ydbase，直接连 Game.dll 的引擎伤害函数；装了 ydbase 也走 native。
;          代价：不加载 ydbase，于是聊天命令 @0/@1/@2/@3/@名字/@?/@! 不可用，改用热键 Ctrl+Alt+数字/R/Q/S。
; auto   = 有 ydbase 就走原 JAPI 路径，没有则自动转 native
; japi   = 强制原 JAPI 路径（没有 ydbase 就什么都不挂）
backend=2
